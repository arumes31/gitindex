# Optional overrides for docker-compose.yml. Every value here has a default
# baked into docker-compose.yml, so this file is OPTIONAL — copy it to ".env"
# only to change something. Docker Compose loads ".env" from this directory
# automatically. (For `go run .` without Docker, export these as env vars.)

# ---- GitHub source ----
GITHUB_USER=arumes31
# Personal access token (classic, public_repo scope). STRONGLY recommended:
# raises the API rate limit from 60/h to 5000/h (matters now that issue/PR
# counts are fetched per repo).
GITHUB_TOKEN=
INCLUDE_FORKS=false
INCLUDE_ARCHIVED=false

# ---- Public URL & SEO (REQUIRED once live for correct canonicals/sitemap) ----
SITE_URL=http://localhost:6541
SITE_NAME=arumes31 · Open Source Projects
SITE_TAGLINE=
SITE_AUTHOR=arumes31
SITE_LOCALE=en_US

# ---- Cache TTLs (Go duration syntax; README TTL is floored to 24h) ----
README_TTL=24h
REPO_LIST_TTL=1h
IMAGE_TTL=24h

# ---- Ports / image ----
APP_PORT=6541
PORT=6541
IMAGE_NAME=gitindex:latest

# ---- Redis (app side) ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Redis (bundled container tuning) ----
REDIS_IMAGE=redis:7-alpine
REDIS_SAVE=60 1
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---- Healthcheck ----
HEALTHCHECK_INTERVAL=30s

# ---- Impressum (legal notice) — REQUIRED before publishing publicly ----
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=
IMPRESSUM_EXTRA=
